CREATE DATABASE IF NOT EXISTS douyin_scraper CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE douyin_scraper;

-- 当前线上主模型（2026-05）
-- 说明：
-- 1. 初始化新环境时，直接建当前实际运行的 dealer_staff / staff_id 模型。
-- 2. 旧的 social_accounts / account_id 结构不再作为初始建库主路径。
-- 3. 已在线上运行的旧环境仍需继续执行 scripts/ 下迁移脚本完成升级。

-- ─── 门店主档 ────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS dealers (
  id                INT           NOT NULL AUTO_INCREMENT,
  brand             VARCHAR(20)   NOT NULL DEFAULT '',
  region            VARCHAR(20)   NOT NULL,
  branch            VARCHAR(50)   NOT NULL,
  sector            VARCHAR(20)   NOT NULL,
  dealer_name       VARCHAR(150)  NOT NULL,
  store_code        VARCHAR(60)   NOT NULL,
  store_name        VARCHAR(150)  NOT NULL,
  store_tier        VARCHAR(60)   DEFAULT NULL,
  store_tier_adj    VARCHAR(60)   DEFAULT NULL,
  created_at        TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
  updated_at        TIMESTAMP     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_store_code (store_code),
  KEY idx_dealers_brand (brand),
  KEY idx_dealers_region (region),
  KEY idx_dealers_branch (branch)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 专员 / 平台账号主表 ─────────────────────────────────────────────────────
-- 一行 = 一名专员在一个平台上的一个账号
CREATE TABLE IF NOT EXISTS dealer_staff (
  id                         INT           NOT NULL AUTO_INCREMENT,
  dealer_id                  INT           NOT NULL,
  contact_name               VARCHAR(50)   NOT NULL DEFAULT '',
  contact_phone              VARCHAR(100)  NOT NULL DEFAULT '',
  is_certified               TINYINT(1)   NOT NULL DEFAULT 1 COMMENT '是否认证通过（1=通过，0=未通过）',
  platform                   VARCHAR(20)   NOT NULL DEFAULT 'douyin',
  account_identifier         VARCHAR(200)  DEFAULT NULL,
  home_url                   VARCHAR(300)  DEFAULT NULL,
  raw_home_url               VARCHAR(1200) DEFAULT NULL,
  nickname                   VARCHAR(200)  DEFAULT NULL,
  signature                  TEXT,
  avatar_url                 VARCHAR(500)  DEFAULT NULL,
  avatar_local               VARCHAR(300)  DEFAULT NULL,
  bg_url                     VARCHAR(500)  DEFAULT NULL,
  bg_local                   VARCHAR(300)  DEFAULT NULL,
  bg_match_standard          TINYINT(1)    DEFAULT NULL COMMENT '主页背景是否与标准图一致（1=一致，0=不一致，NULL=未比对）',
  bg_match_score             INT           DEFAULT NULL COMMENT 'SIFT 特征匹配点数量',
  follower_count             BIGINT        DEFAULT 0,
  total_favorited            BIGINT        DEFAULT 0,
  video_count                INT           DEFAULT 0,
  video_total_count          INT           DEFAULT 0,
  keyword_video_count        INT           DEFAULT 0,
  resolve_status             VARCHAR(10)   NOT NULL DEFAULT 'pending',
  resolve_error              VARCHAR(80)   DEFAULT NULL,
  status                     ENUM('active','error','pending') NOT NULL DEFAULT 'pending',
  last_scraped_at            DATETIME      DEFAULT NULL,
  last_attempt_at            DATETIME      DEFAULT NULL,
  last_attempt_status        ENUM('success','error') DEFAULT NULL,
  last_success_at            DATETIME      DEFAULT NULL,
  has_success                TINYINT(1)    NOT NULL DEFAULT 0,
  earliest_captured_video_at DATETIME      DEFAULT NULL,
  last_scrape_error          TEXT,
  created_at                 TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
  updated_at                 TIMESTAMP     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_ds_platform_home_url (platform, home_url(200)),
  KEY idx_ds_dealer_id (dealer_id),
  KEY idx_ds_platform (platform),
  KEY idx_ds_status (status),
  KEY idx_ds_identifier (account_identifier),
  KEY idx_ds_has_success (has_success),
  CONSTRAINT fk_ds_dealer FOREIGN KEY (dealer_id) REFERENCES dealers (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 视频 / 笔记内容表 ───────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS videos (
  id                INT          NOT NULL AUTO_INCREMENT,
  staff_id          INT          NOT NULL,
  aweme_id          VARCHAR(100) NOT NULL,
  video_url         VARCHAR(500) DEFAULT NULL,
  title             TEXT,
  like_count        BIGINT       DEFAULT 0,
  comment_count     BIGINT       DEFAULT 0,
  share_count       BIGINT       DEFAULT 0,
  forward_count     BIGINT       DEFAULT 0,
  collected_count   BIGINT       DEFAULT 0,
  cover_url         VARCHAR(500) DEFAULT NULL,
  cover_local       VARCHAR(300) DEFAULT NULL,
  note_content      TEXT         DEFAULT NULL,
  matched_keywords  VARCHAR(500) DEFAULT NULL,
  is_starred        TINYINT(1)   DEFAULT 0,
  douyin_created_at DATETIME     DEFAULT NULL,
  scraped_at        DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  -- ─── 优秀视频赋能（2026-06 新增）────────────────────────────────────────────
  video_local       VARCHAR(300) DEFAULT NULL  COMMENT '本地视频/音频文件路径（相对 IMAGES_DIR）',
  video_dl_status   ENUM('none','downloading','done','error') NOT NULL DEFAULT 'none' COMMENT '视频下载状态',
  video_dl_error    TEXT         DEFAULT NULL  COMMENT '下载失败原因',
  ai_transcript     TEXT         DEFAULT NULL  COMMENT 'ASR 语音转文字结果（qwen3-asr-flash）',
  ai_analysis       MEDIUMTEXT   DEFAULT NULL  COMMENT 'AI 内容分析结果（Markdown）',
  ai_script         MEDIUMTEXT   DEFAULT NULL  COMMENT 'AI 仿写脚本（Markdown）',
  ai_analyzed_at    DATETIME     DEFAULT NULL  COMMENT '最近一次 AI 分析时间',
  PRIMARY KEY (id),
  UNIQUE KEY uq_aweme_id (aweme_id),
  KEY idx_videos_staff_id (staff_id),
  KEY idx_videos_scraped_at (scraped_at),
  KEY idx_videos_created_at (douyin_created_at),
  CONSTRAINT fk_videos_staff FOREIGN KEY (staff_id) REFERENCES dealer_staff (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 每日快照 ────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS account_snapshots (
  id               INT    NOT NULL AUTO_INCREMENT,
  staff_id         INT    NOT NULL,
  snapshot_date    DATE   NOT NULL,
  follower_count   BIGINT DEFAULT 0,
  total_favorited  BIGINT DEFAULT 0,
  video_count      INT    DEFAULT 0,
  PRIMARY KEY (id),
  UNIQUE KEY uq_snapshot_staff_date (staff_id, snapshot_date),
  KEY idx_snapshot_date (snapshot_date),
  CONSTRAINT fk_snapshots_staff FOREIGN KEY (staff_id) REFERENCES dealer_staff (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 全局关键词配置 ───────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS keywords (
  id         INT          NOT NULL AUTO_INCREMENT,
  keyword    VARCHAR(200) NOT NULL,
  is_active  TINYINT(1)   NOT NULL DEFAULT 1,
  created_at DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_keyword (keyword)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 爬取日志 ────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS scrape_logs (
  id           INT          NOT NULL AUTO_INCREMENT,
  batch_id     VARCHAR(50)  NOT NULL,
  staff_id     INT          NOT NULL,
  status       ENUM('success','error','skipped') NOT NULL,
  videos_found INT          DEFAULT 0,
  error_msg    TEXT,
  duration_ms  INT          DEFAULT 0,
  scraped_at   DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_logs_batch_id (batch_id),
  KEY idx_logs_staff_id (staff_id),
  KEY idx_logs_scraped_at (scraped_at),
  CONSTRAINT fk_logs_staff FOREIGN KEY (staff_id) REFERENCES dealer_staff (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 系统配置 ────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS settings (
  `key`        VARCHAR(100) NOT NULL,
  `value`      MEDIUMTEXT,
  description  VARCHAR(300) DEFAULT NULL,
  updated_at   DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`key`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


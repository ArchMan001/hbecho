-- ─── 活动主表 ────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS campaign_events (
  id              INT           NOT NULL AUTO_INCREMENT,
  campaign_code   VARCHAR(80)   NOT NULL,
  campaign_name   VARCHAR(200)  NOT NULL,
  start_date      DATE          NOT NULL,
  end_date        DATE          NOT NULL,
  status          ENUM('draft','active','closed') NOT NULL DEFAULT 'draft',
  description     TEXT,
  match_keywords  TEXT          DEFAULT NULL,
  created_at      TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
  updated_at      TIMESTAMP     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_campaign_code (campaign_code)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 活动视频类型（三层关键词体系：活动→视频类型→关键词）────────────────────────
CREATE TABLE IF NOT EXISTS campaign_video_types (
  id             INT          NOT NULL AUTO_INCREMENT,
  campaign_id    INT          NOT NULL,
  type_name      VARCHAR(100) NOT NULL,
  sort_order     INT          NOT NULL DEFAULT 0,
  required_count INT          NOT NULL DEFAULT 1 COMMENT '该类型达标所需发布条数',
  created_at     TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_cvt_campaign (campaign_id),
  CONSTRAINT fk_cvt_campaign FOREIGN KEY (campaign_id) REFERENCES campaign_events (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 视频类型关键词（OR-of-AND 匹配：同 rule_group AND，不同 rule_group OR）────
-- rule_group: 同组内关键词全部命中才算该组成立（AND）；多组之间取 OR；
--             关键词中的空格会拆成多个子词，每个子词都必须出现（子词 AND）
CREATE TABLE IF NOT EXISTS campaign_type_keywords (
  id            INT          NOT NULL AUTO_INCREMENT,
  video_type_id INT          NOT NULL,
  keyword       VARCHAR(200) NOT NULL,
  rule_group    TINYINT      NOT NULL DEFAULT 0 COMMENT '同组关键词 AND，组间 OR',
  sort_order    INT          NOT NULL DEFAULT 0,
  PRIMARY KEY (id),
  UNIQUE KEY uq_type_keyword (video_type_id, keyword),
  KEY idx_ctk_type (video_type_id),
  CONSTRAINT fk_ctk_type FOREIGN KEY (video_type_id) REFERENCES campaign_video_types (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 视频命中记录（权威匹配记录，实时写入）──────────────────────────────────
CREATE TABLE IF NOT EXISTS video_type_matches (
  id            INT      NOT NULL AUTO_INCREMENT,
  video_id      INT      NOT NULL,
  campaign_id   INT      NOT NULL,
  video_type_id INT      NOT NULL,
  matched_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_video_type (video_id, video_type_id),
  KEY idx_vtm_video (video_id),
  KEY idx_vtm_campaign (campaign_id),
  KEY idx_vtm_type (video_type_id),
  CONSTRAINT fk_vtm_video    FOREIGN KEY (video_id)      REFERENCES videos (id)               ON DELETE CASCADE,
  CONSTRAINT fk_vtm_campaign FOREIGN KEY (campaign_id)   REFERENCES campaign_events (id)      ON DELETE CASCADE,
  CONSTRAINT fk_vtm_type     FOREIGN KEY (video_type_id) REFERENCES campaign_video_types (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 门店级活动参与关系 ───────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS dealer_campaign_membership (
  id               INT          NOT NULL AUTO_INCREMENT,
  campaign_id      INT          NOT NULL,
  dealer_id        INT          NOT NULL,
  is_participating TINYINT(1)   NOT NULL DEFAULT 1,
  tagged_by        VARCHAR(100) DEFAULT NULL,
  tagged_at        DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  source           ENUM('manual','rule','import') NOT NULL DEFAULT 'manual',
  note             VARCHAR(500) DEFAULT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_campaign_dealer (campaign_id, dealer_id),
  KEY idx_membership_campaign (campaign_id),
  KEY idx_membership_dealer (dealer_id),
  CONSTRAINT fk_membership_campaign FOREIGN KEY (campaign_id) REFERENCES campaign_events (id) ON DELETE CASCADE,
  CONSTRAINT fk_membership_dealer FOREIGN KEY (dealer_id) REFERENCES dealers (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 账号级活动参与关系 ───────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS staff_campaign_membership (
  id                    INT          NOT NULL AUTO_INCREMENT,
  campaign_id           INT          NOT NULL,
  staff_id              INT          NOT NULL,
  is_participating      TINYINT(1)   NOT NULL DEFAULT 1,
  qualified_video_count INT          DEFAULT 0,
  tagged_by             VARCHAR(100) DEFAULT NULL,
  tagged_at             DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  source                ENUM('manual','rule','import') NOT NULL DEFAULT 'manual',
  note                  VARCHAR(500) DEFAULT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_campaign_staff (campaign_id, staff_id),
  KEY idx_scm_campaign (campaign_id),
  KEY idx_scm_staff (staff_id),
  CONSTRAINT fk_scm_campaign FOREIGN KEY (campaign_id) REFERENCES campaign_events (id) ON DELETE CASCADE,
  CONSTRAINT fk_scm_staff FOREIGN KEY (staff_id) REFERENCES dealer_staff (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 门店级活动聚合统计 ───────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS dealer_campaign_stats (
  id                       INT      NOT NULL AUTO_INCREMENT,
  campaign_id              INT      NOT NULL,
  dealer_id                INT      NOT NULL,
  total_videos_in_window   INT      DEFAULT 0,
  keyword_videos_in_window INT      DEFAULT 0,
  total_like_in_window     BIGINT   DEFAULT 0,
  total_comment_in_window  BIGINT   DEFAULT 0,
  total_share_in_window    BIGINT   DEFAULT 0,
  first_post_at            DATETIME DEFAULT NULL,
  last_post_at             DATETIME DEFAULT NULL,
  updated_at               DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_stats_campaign_dealer (campaign_id, dealer_id),
  KEY idx_stats_campaign (campaign_id),
  KEY idx_stats_dealer (dealer_id),
  CONSTRAINT fk_stats_campaign FOREIGN KEY (campaign_id) REFERENCES campaign_events (id) ON DELETE CASCADE,
  CONSTRAINT fk_stats_dealer FOREIGN KEY (dealer_id) REFERENCES dealers (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ─── 后台管理员 ──────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS admin_users (
  id                INT UNSIGNED  NOT NULL AUTO_INCREMENT,
  username          VARCHAR(80)   NOT NULL,
  password_hash     VARCHAR(255)  NOT NULL,
  role              ENUM('admin','viewer') NOT NULL DEFAULT 'viewer',
  brand_permissions JSON          NOT NULL,
  is_active         TINYINT(1)    NOT NULL DEFAULT 1,
  created_at        TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
  updated_at        TIMESTAMP     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_username (username)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ─── 爬取任务队列（前端触发，daemon 消费）────────────────────────────────────
CREATE TABLE IF NOT EXISTS scrape_jobs (
  id            INT          NOT NULL AUTO_INCREMENT,
  mode          ENUM('full','campaign','bg-rescrape','bg-rematch') NOT NULL DEFAULT 'full',
  campaign_id   INT          DEFAULT NULL,
  full_refresh  TINYINT(1)   NOT NULL DEFAULT 0,
  account_limit INT          DEFAULT NULL,
  status        ENUM('pending','running','done','error') NOT NULL DEFAULT 'pending',
  created_by    VARCHAR(80)  DEFAULT NULL,
  created_at    DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  started_at    DATETIME     DEFAULT NULL,
  finished_at   DATETIME     DEFAULT NULL,
  result_msg    TEXT         DEFAULT NULL,
  -- 实时进度（爬虫运行时写入，前端轮询展示）
  progress_total         INT      DEFAULT NULL,  -- 目标账号总数
  progress_done          INT      DEFAULT NULL,  -- 已处理数（成功+失败）
  progress_success       INT      DEFAULT NULL,  -- 成功数
  progress_error         INT      DEFAULT NULL,  -- 失败数
  progress_batch         INT      DEFAULT NULL,  -- 当前批次序号
  progress_total_batches INT      DEFAULT NULL,  -- 总批次数
  progress_updated_at    DATETIME DEFAULT NULL,  -- 进度最后更新时间
  PRIMARY KEY (id),
  KEY idx_sj_status  (status),
  KEY idx_sj_created (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

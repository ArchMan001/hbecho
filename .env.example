# 键名清单（不含任何真实值）。真实值只放本机 / 服务器的 .env，永不入库、永不写进日志与回复（server-access.md）。
# 带「必填」的键缺失时对应进程启动失败。

# ---- 数据库 ----
HBECHO_DATABASE_URL=

# ---- 访问控制 b-access-control（Web 进程）----
# 必填。better-auth 签名密钥，至少 32 个字符
HBECHO_AUTH_SECRET=
# 必填。对外访问的 origin（协议 + 域名，不含路径）；生产必须 https
HBECHO_PUBLIC_ORIGIN=
# 可选。额外受信的 origin，逗号分隔（来源检查：不在其中的状态变更请求被拒）
HBECHO_TRUSTED_ORIGINS=
# 必填。fake | aliyun；生产只允许 aliyun，不缺省为假发送器
HBECHO_SMS_MODE=
# 必填。每日全局短信上限（达到后短信类请求暂停并告警，密码登录不受影响）
HBECHO_SMS_DAILY_CAP=
# 生产必填。受信反向代理的 IP / CIDR，逗号分隔（Nginx 所在地址）。Nginx 必须用
#   proxy_set_header X-Forwarded-For $remote_addr;
# 覆盖客户端自带的头；否则限流取不到可信 IP，所有请求落进同一个共享桶
HBECHO_TRUSTED_PROXIES=
# 可选，缺省：生产 300、非生产 60。每个 IP 每条认证路径每分钟的请求上限（不是全局）
HBECHO_AUTH_RATE_LIMIT_PER_MIN=

# 对外开放的站点必填（运维手册 §10.6 第 5 条）：ICP 备案号，显示在页面页脚并链接到工信部；本地与 CI 不设置时不显示
HBECHO_ICP_NUMBER=
# ---- 阿里云短信：仅 HBECHO_SMS_MODE=aliyun 时必填 ----
# 专用的显式 AccessKey（对照 hbdam：不走实例 RAM 角色、不复用 OSS 密钥），RAM 子账号只授予 dysms:SendSms。签名：青岛海信博世
HBECHO_SMS_ACCESS_KEY_ID=
HBECHO_SMS_ACCESS_KEY_SECRET=
HBECHO_SMS_SIGN_NAME=
HBECHO_SMS_TEMPLATE_ACTIVATE=
HBECHO_SMS_TEMPLATE_LOGIN=
HBECHO_SMS_TEMPLATE_RESET=

# ---- 采集 / 对象存储（既有，键名取自本机 .env）----
AIMASTER_BASE_URL=
AIMASTER_API_KEY=
AIMASTER_ENABLED=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
OSS_BUCKET_ODS=
OSS_ENDPOINT=

# ── 访问控制 CLI（pnpm run access ...）──────────────────────────────────────────
# 需要身份的命令（user *、audit list、user import *）以哪个真实用户的身份操作：user:<id>，必须是有效用户。
# 角色与范围一律从数据库现算，不接受自行声明。token create / bootstrap-superadmin / maintain 只需要 HBECHO_DATABASE_URL。
# HBECHO_ACCESS_ACTOR=user:1

# ── 学习平台（g-learning-min）──────────────────────────────────────────────────
# 凭证来源：ecs_role = ECS 实例 RAM 角色 hbecho-ecs-role（生产首选，不需要任何 AccessKey）；
#            access_key（缺省）= 下面的固定 AccessKey，缺省回退到上面的 OSS_ACCESS_KEY_ID / SECRET（本机 .env 里那组是 setup 身份，生产不要依赖回退）。
# 身份需要：hbecho-course 桶读写删列（hbecho-oss-rw）+ VOD 运行期动作（hbecho-vod-runtime，见 ADR-0007 补记）。
HBECHO_LEARNING_CREDENTIALS=
HBECHO_LEARNING_ACCESS_KEY_ID=
HBECHO_LEARNING_ACCESS_KEY_SECRET=
# 缺省 hbecho-course；地域缺省取 OSS_REGION（cn-beijing 或 oss-cn-beijing 均可）
HBECHO_COURSE_OSS_BUCKET=
HBECHO_COURSE_OSS_REGION=
HBECHO_COURSE_OSS_ENDPOINT=
# 阿里云 Web 播放器 License（控制台申请，与播放页面域名绑定；没有就只能本地调试）
HBECHO_PLAYER_LICENSE_DOMAIN=
HBECHO_PLAYER_LICENSE_KEY=
# pnpm learning-smoke 的人工批准开关（真实桶，小对象，用完即删）
# HBECHO_LEARNING_SMOKE=approved
# pnpm learning-smoke-vod 的人工批准开关（真实 VOD，3 秒 MP4，需要本机 ffmpeg，用完即删）
# HBECHO_LEARNING_SMOKE_VOD=approved

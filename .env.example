# 键名清单（不含任何真实值）。真实值只放本机 / 服务器的 .env，永不入库、永不写进日志与回复（server-access.md）。
# 带「必填」的键缺失时对应进程启动失败。

# ---- 数据库 ----
HBECHO_DATABASE_URL=

# ---- 访问控制 b-access-control（Web 进程）----
# 必填。better-auth 签名密钥，至少 32 个字符
HBECHO_AUTH_SECRET=
# 必填。对外访问的 origin（协议 + 域名，不含路径）；生产必须 https
HBECHO_PUBLIC_ORIGIN=
# 可选。额外受信的 origin，逗号分隔（来源检查：不在其中的状态变更请求被拒）
HBECHO_TRUSTED_ORIGINS=
# 必填。fake | aliyun；生产只允许 aliyun，不缺省为假发送器
HBECHO_SMS_MODE=
# 必填。每日全局短信上限（达到后短信类请求暂停并告警，密码登录不受影响）
HBECHO_SMS_DAILY_CAP=
# 生产必填。受信反向代理的 IP / CIDR，逗号分隔（Nginx 所在地址）。Nginx 必须用
#   proxy_set_header X-Forwarded-For $remote_addr;
# 覆盖客户端自带的头；否则限流取不到可信 IP，所有请求落进同一个共享桶
HBECHO_TRUSTED_PROXIES=
# 可选，缺省：生产 300、非生产 60。每个 IP 每条认证路径每分钟的请求上限（不是全局）
HBECHO_AUTH_RATE_LIMIT_PER_MIN=

# 对外开放的站点必填（运维手册 §10.6 第 5 条）：ICP 备案号，显示在页面页脚并链接到工信部；本地与 CI 不设置时不显示
HBECHO_ICP_NUMBER=
# ---- 阿里云短信：仅 HBECHO_SMS_MODE=aliyun 时必填 ----
# 专用的显式 AccessKey（对照 hbdam：不走实例 RAM 角色、不复用 OSS 密钥），RAM 子账号只授予 dysms:SendSms。签名：青岛海信博世
HBECHO_SMS_ACCESS_KEY_ID=
HBECHO_SMS_ACCESS_KEY_SECRET=
HBECHO_SMS_SIGN_NAME=
HBECHO_SMS_TEMPLATE_ACTIVATE=
HBECHO_SMS_TEMPLATE_LOGIN=
HBECHO_SMS_TEMPLATE_RESET=

# ---- 采集 / 对象存储（既有，键名取自本机 .env）----
AIMASTER_BASE_URL=
AIMASTER_API_KEY=
AIMASTER_ENABLED=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
OSS_BUCKET_ODS=
OSS_ENDPOINT=
# 正式媒资桶与 C 的专用桶（hbecho-signals，存标准图）；CLI 的 segment 写入与 signals run 需要，桶尚未创建（见 server-operations-runbook）
OSS_BUCKET_MEDIA=
OSS_BUCKET_SIGNALS=
# 视频广场（f-video-square）给封面签短期读取地址：只需要 OSS_BUCKET_MEDIA 的读权限；缺任一项时封面全部显示占位图（页面照常）。
# 不读 OSS_ENDPOINT（可能是内网地址，签出的 URL 浏览器打不开）。凭证缺省回退到上面的 OSS_ACCESS_KEY_*，生产建议单独给只读身份。
HBECHO_SQUARE_ACCESS_KEY_ID=
HBECHO_SQUARE_ACCESS_KEY_SECRET=
# 封面签名有效期（秒），60–3600，缺省 900
HBECHO_SQUARE_COVER_TTL_S=
# Python 能力服务根地址（与 sync worker 共用），例如 http://capability:8080
HBECHO_CAPABILITY_URL=

# ── 识别能力 C（pnpm signals ...，c-signals）────────────────────────────────────
# 以下数值**没有代码默认值**，缺任一项启动失败并点名。注释里的“起始值”来自 design §14 第 14 项，只是测试机实测前的建议，不是合同；
# 重试退避基数没有建议值，按测试机实测定。HBECHO_MEDIA_MAX_BYTES 与 sync worker 共用（候选图上限）。
# 起始值 30000
HBECHO_SIGNALS_SCAN_INTERVAL_MS=
# 起始值 500
HBECHO_SIGNALS_SCAN_BATCH=
# 起始值 600000（10 分钟）
HBECHO_SIGNALS_LOOKBACK_MS=
# 起始值 3600000（每小时）
HBECHO_SIGNALS_RECONCILE_INTERVAL_MS=
# 起始值 2
HBECHO_SIGNALS_SCORE_CONCURRENCY=
# 起始值 3
HBECHO_SIGNALS_TASK_MAX_ATTEMPTS=
HBECHO_SIGNALS_RETRY_BACKOFF_MS=
# 起始值 120000；必须大于 MATCH_TIMEOUT_MS
HBECHO_SIGNALS_LEASE_MS=
# 起始值 600
HBECHO_SIGNALS_SIGNED_URL_TTL_S=
# 起始值 60000
HBECHO_SIGNALS_MATCH_TIMEOUT_MS=
# 起始值 30000
HBECHO_SIGNALS_DEFER_INTERVAL_MS=
# 起始值 20
HBECHO_SIGNALS_DEFER_MAX=
HBECHO_MEDIA_MAX_BYTES=
# 启用的能力标识，逗号分隔。缺省只启用文本类；image.template / image.element 在标定报告签字前不得进生产启用集；speech.* 另需网关有模型（C 不自带网关）
HBECHO_SIGNALS_ENABLED=
# CLI / run 的身份：缺任一项启动失败，不退化成全部范围。HBECHO_SIG_BRAND_SCOPE 取 all 或品牌编码逗号分隔
HBECHO_SIG_ACTOR=
HBECHO_SIG_CAPABILITIES=
HBECHO_SIG_BRAND_SCOPE=

# ── 访问控制 CLI（pnpm run access ...）──────────────────────────────────────────
# 需要身份的命令（user *、audit list、user import *）以哪个真实用户的身份操作：user:<id>，必须是有效用户。
# 角色与范围一律从数据库现算，不接受自行声明。token create / bootstrap-superadmin / maintain 只需要 HBECHO_DATABASE_URL。
# HBECHO_ACCESS_ACTOR=user:1

# ── 学习平台（g-learning-min）──────────────────────────────────────────────────
# 凭证来源：ecs_role = ECS 实例 RAM 角色 hbecho-ecs-role（生产首选，不需要任何 AccessKey）；
#            access_key（缺省）= 下面的固定 AccessKey，缺省回退到上面的 OSS_ACCESS_KEY_ID / SECRET（本机 .env 里那组是 setup 身份，生产不要依赖回退）。
# 身份需要：hbecho-course 桶读写删列（hbecho-oss-rw）+ VOD 运行期动作（hbecho-vod-runtime，见 ADR-0007 补记）。
HBECHO_LEARNING_CREDENTIALS=
HBECHO_LEARNING_ACCESS_KEY_ID=
HBECHO_LEARNING_ACCESS_KEY_SECRET=
# 缺省 hbecho-course；地域缺省取 OSS_REGION（cn-beijing 或 oss-cn-beijing 均可）
HBECHO_COURSE_OSS_BUCKET=
HBECHO_COURSE_OSS_REGION=
HBECHO_COURSE_OSS_ENDPOINT=
# 阿里云 Web 播放器 License（控制台申请，与播放页面域名绑定；没有就只能本地调试）
HBECHO_PLAYER_LICENSE_DOMAIN=
HBECHO_PLAYER_LICENSE_KEY=
# pnpm learning-smoke 的人工批准开关（真实桶，小对象，用完即删）
# HBECHO_LEARNING_SMOKE=approved
# pnpm learning-smoke-vod 的人工批准开关（真实 VOD，3 秒 MP4，需要本机 ffmpeg，用完即删）
# HBECHO_LEARNING_SMOKE_VOD=approved

# ---- d-rule-engine（判定执行；数值类配置没有代码默认值，缺任一项启动失败，见 design §14 第 22 项）----
# 起始建议值（实测后调整，不是合同）：块 200、信号批 1000、需求批 1000（两者 ≤ 5000）、轮询 30 秒、信号等待 600 秒、
# 采集等待 7200 秒（等待上限可为 0）、租约 120 秒、tick 预算 5000 毫秒、阶段最多重试 5 次、关键词 / 话题每项 50 个、单个 64 字符、
# 圈定与试跑保留 30 天、每（计划，版本）保留最近 5 次执行的内容级行、失败运行保留 30 天。身份：HBECHO_JP_ACTOR=user:<id>。
# D 还要装配 C 的 Module，因此 HBECHO_SIGNALS_* 数值配置也必须齐；`pnpm judgement serve` 另需 A 需求的运行模式 HBECHO_SYNC_DETAIL_MODE / HBECHO_SYNC_COMMENTS_MODE（synchronous | asynchronous，值由 A 的采集 worker 同一份配置决定）；
# OSS_BUCKET_SIGNALS / OSS_BUCKET_MEDIA / HBECHO_CAPABILITY_URL 用到才读（image put 等）。
HBECHO_JP_ACTOR=
HBECHO_JP_BLOCK_SIZE=
HBECHO_JP_SIGNAL_BATCH=
HBECHO_JP_DEMAND_BATCH=
HBECHO_JP_POLL_SECONDS=
HBECHO_JP_WAIT_SIGNAL_SECONDS=
HBECHO_JP_WAIT_DEMAND_SECONDS=
HBECHO_JP_LEASE_SECONDS=
HBECHO_JP_TICK_BUDGET_MS=
HBECHO_JP_PHASE_MAX_ATTEMPTS=
HBECHO_JP_MAX_ITEMS=
HBECHO_JP_MAX_KEYWORD_LENGTH=
HBECHO_JP_TRIAL_RETENTION_DAYS=
HBECHO_JP_KEEP_CONTENT_RUNS=
HBECHO_JP_FAILED_RETENTION_DAYS=

# ============================================================
# 复制此文件为 .env 并填入真实值
# .env 不提交到 git
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=douyin_scraper
MYSQL_USER=douyin_user
MYSQL_PASSWORD=change_me_db_password

# Web 管理界面登录账号
WEB_AUTH_USER=liuxuekui
WEB_AUTH_PASS=admin123

# 端口（按项目约定）
WEB_PORT=3004

# 图片存储根目录（容器内路径）
IMAGES_DIR=/app/images

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ─── AI 大模型（通义千问 / 阿里云百炼）──────────────────────────────────────
# 在 https://dashscope.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型选择：qwen-turbo（快/便宜）| qwen-plus（均衡）| qwen-max（最强）
DASHSCOPE_MODEL=qwen-plus
# 语音转写模型（可选，默认 qwen3-asr-flash，base64 上传上限 10MB）
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# 公网域名（音频 >10MB 时改走 URL 方式；≤10MB 一律走 base64，本地开发可留空）
VIDEO_BASE_URL=https://ai.liuxuekui.click

# ─── 飞书 Aily OpenAPI ────────────────────────────────────────────────────────
# 飞书开放平台自建应用凭证：https://open.feishu.cn/app/
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Aily 应用 ID（从 aily 应用开发页地址栏获取，格式: spring_xxx__c）
AILY_APP_ID=spring_xxxxxxxxxxxxxxxx__c
